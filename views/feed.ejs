<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>BlurTalk - Feed</title>
</head>
<body class="min-h-screen bg-zinc-950 text-white relative overflow-x-hidden">
    <div class="absolute bg-blue-600 rounded-full blur-[180px] opacity-20"></div>
    <div class="absolute bg-purple-600 rounded-full blur-[180px] opacity-20"></div>
    <nav class="fixed top-0 left-0 w-full bg-zinc-900/90 backdrop-blur-xl border-b border-zinc-800 shadow-md py-4 px-6 flex justify-between items-center z-50">
        <h1 class="text-5xl font-bold text-cyan-700"><%= usermap[cuser] %></h1>
        <h1 class="text-2xl font-bold text-blue-500">BlurTalk</h1>
        <div class="flex gap-4">
            <a href="/profile" class="bg-blue-600 hover:bg-blue-700 transition px-5 py-2 rounded-xl font-semibold">Profile</a>
            <a href="/logout" class="bg-red-600 hover:bg-red-700 transition px-5 py-2 rounded-xl font-semibold">Logout</a>
        </div>
    </nav>
    <div class="relative max-w-5xl mx-auto px-6 pt-28 pb-12 space-y-6">
        <div class="bg-zinc-900/70 backdrop-blur-xl border border-zinc-800 rounded-3xl p-6 shadow-lg">
            <h3 class="text-xl text-zinc-400 mb-4 font-semibold">Create a New Post</h3>
            <form action="/post" method="post" class="flex flex-col gap-4">
                <textarea name="content" class="bg-zinc-800 border border-zinc-700 rounded-2xl p-4 text-lg resize-none h-40 focus:outline-none focus:ring-2 focus:ring-blue-600 transition" placeholder="Write something new..." required></textarea>
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 transition px-6 py-3 rounded-xl font-semibold shadow-lg hover:shadow-blue-600/40 w-fit">Post</button>
            </form>
        </div>
        <h2 class="text-3xl font-bold mb-4">All Posts</h2>
        <% if (posts.length === 0) { %>
            <div class="text-zinc-500 text-lg text-center py-10">Pretty empty here...</div>
        <% } else { %>
            <div class="flex flex-col gap-6">
                <% posts.slice().reverse().forEach((val) => { %>
                    <div class="bg-zinc-900/70 backdrop-blur-xl border border-zinc-800 rounded-3xl p-6 shadow-lg">
                        <h5 class="text-blue-400 font-semibold mb-2">@<%= usermap[val.user] %></h5>
                        <p class="whitespace-pre-line text-zinc-200 text-lg"><%= val.content %></p>
                        <div class="flex justify-between mt-4 text-sm items-center">
                            <a href="/like/<%= val._id %>" class="text-zinc-400 hover:text-white transition font-semibold">
                                <% if (val.likes.indexOf(cuser) === -1) { %>
                                    Like
                                <% } else { %>
                                    Unlike
                                <% } %>
                                <% if (val.likes.length > 0) { %>
                                    <span class="ml-1">(<%= val.likes.length %>)</span>
                                <% } %>
                            </a>
                            <% if (val.user === cuser) { %>
                                <a href="/edit/<%= val._id %>" class="text-blue-400 hover:text-white transition font-semibold">Edit</a>
                            <% } %>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </div>
    <footer class="bg-zinc-950 text-zinc-400 p-4 text-center rounded-t-3xl mt-4">
        © 2026 BlurTalk. All rights reserved.
    </footer>
</body>
</html>