<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>BlurTalk - Profile</title>
</head>
<body class="min-h-screen bg-zinc-950 text-white relative overflow-x-hidden">
    <div class="absolute bg-blue-600 rounded-full blur-[180px] opacity-20"></div>
    <div class="absolute bg-purple-600 rounded-full blur-[180px] opacity-20"></div>
    <div class="relative max-w-5xl mx-auto px-6 py-12">
        <div class="bg-zinc-900/70 backdrop-blur-xl border border-zinc-800 rounded-3xl p-8 shadow-2xl mb-10">
            <div class="flex justify-between items-center flex-wrap gap-4">
                <h1 class="text-4xl font-bold">
                    Welcome, <span class="text-blue-500"><%= user.username %></span>
                </h1>
                <div class="flex gap-4">
                    <a href="/feed" class="bg-zinc-800 hover:bg-zinc-700 transition px-5 py-2 rounded-xl font-semibold">Feed</a>
                    <a href="/logout" class="bg-red-600 hover:bg-red-700 transition px-5 py-2 rounded-xl font-semibold">Logout</a>
                </div>
            </div>
        </div>
        <div class="bg-zinc-900/70 backdrop-blur-xl border border-zinc-800 rounded-3xl p-8 shadow-2xl mb-10">
            <h3 class="text-xl text-zinc-400 mb-4">Create a new post</h3>
            <form action="/post" method="post" class="flex flex-col gap-4">
                <textarea
                    name="content"
                    class="bg-zinc-800 border border-zinc-700 rounded-2xl p-4 w-full text-lg resize-none h-40 focus:outline-none focus:ring-2 focus:ring-blue-600 transition"
                    placeholder="Write something new..."
                    required></textarea>
                <button
                    class="bg-blue-600 hover:bg-blue-700 transition px-6 py-3 rounded-xl font-semibold w-fit">
                    Post
                </button>
            </form>
        </div>
        <div class="bg-zinc-900/70 backdrop-blur-xl border border-zinc-800 rounded-3xl p-8 shadow-2xl">
            <h2 class="text-3xl font-bold mb-6">Your Posts</h2>
            <div class="flex flex-col gap-6">
                <% if(posts.length === 0){ %>
                    <div class="text-zinc-500 text-lg">Pretty empty here...</div>
                <% } else { %>
                    <% posts.slice().reverse().forEach((val)=>{ %>
                        <div class="bg-zinc-800 border border-zinc-700 rounded-2xl p-5">
                            <h5 class="text-blue-400 font-semibold mb-2">@<%= user.username %></h5>
                            <p class="whitespace-pre-line text-zinc-200"><%= val.content %></p>
                            <div class="flex justify-between mt-4 text-sm">
                                <a class="text-zinc-400 hover:text-white transition" href="/like/<%=val._id%>">
                                    <% if(val.likes.indexOf(user._id)===-1){ %>
                                        Like
                                    <% } else { %>
                                        Unlike
                                    <% } %>
                                    <% if(val.likes.length>0){ %>
                                        <%= val.likes.length %>
                                    <% } %>
                                </a>
                                <a class="text-zinc-400 hover:text-white transition font-semibold" href="/edit/<%=val._id%>?content=<%=encodeURIComponent(val.content)%>">
                                    Edit
                                </a>
                            </div>
                        </div>
                    <% }); %>
                <% } %>
            </div>
        </div>
    </div>
    <footer class="bg-zinc-950 text-zinc-400 p-4 text-center rounded-t-3xl mt-4">
        © 2026 BlurTalk. All rights reserved.
    </footer>
</body>
</html>